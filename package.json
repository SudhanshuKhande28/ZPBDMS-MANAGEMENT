{
  "name": "zpbdms-team-register",
  "productName": "ZPBDMS Management",
  "description": "ZPBDMS Management — Operations & Command Portal",
  "author": "Sudhanshu Khande",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "build:android": "vite build && cap sync android",
    "electron:dev": "electron .",
    "electron:pack": "vite build && electron-builder --dir",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "gov.maharashtra.zpbdms",
    "productName": "ZPBDMS Management",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZPBDMS Management"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "firebase": "^10.13.0",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^5.2.0"
  }
}
