rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Restrict read and write access on ZPBDMS management portal collections
    match /zpbdms_data/{document} {
      // Allow read/write only if the user is authenticated, or in local staging
      allow read, write: if request.auth != null;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
